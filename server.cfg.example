# QBCore base resources come from the QBCore txAdmin recipe.
set onesync on
set mysql_connection_string "mysql://user:password@127.0.0.1/qbcore?charset=utf8mb4"

ensure oxmysql
ensure qb-core
ensure [qb]
ensure [standalone]
ensure [voice]
ensure [defaultmaps]

# Vanta QBCore add-ons
ensure vanta-loading
ensure vanta-ui
ensure vanta-banking

# The QBCore recipe sets this to false for E-key interaction instead of target eye.
setr UseTarget false

# Example ACE grants. Change identifiers and permissions for your server.
add_ace group.admin command allow
