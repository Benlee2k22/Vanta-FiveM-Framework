# QBCore resources and database are installed by the txAdmin recipe.
set onesync on
set mysql_connection_string "mysql://user:password@127.0.0.1/qbcore?charset=utf8mb4"

ensure oxmysql
ensure qb-core
ensure [qb]
ensure [standalone]
ensure [voice]
ensure [defaultmaps]

setr UseTarget false
ensure vanta-loading
ensure vanta-ui

add_ace group.admin command allow
